    "block_marker": "#4D9375",
    "marker": "#666666",
    "list_marker": "#D4976C",
    "task": "#D4976C",
    "hr": "#666666",
    "quote": "#5D99A9",
    "link": "#C98A7D",
    "url": "#858480",
    "code": "#4D9375",
    "code_block": "#4D9375",
    "emphasis": {
      "color": "#CECABE",
      "font_style": "italic"
    },
    "strong": {
      "color": "#CECABE",
      "font_weight": 700
    },
    "front_matter": "#687668",
    "html": "#4D9375",
    "escape": "#E6CC77",
    "comment": "#687668",
    "comment_doc": "#687668",
    "keyword": "#4D9375",
    "string": "#C98A7D",
    "string_special": "#C4704F",
    "function": "#80A665",
    "type": "#5DA994",
    "type_constructor": "#80A665",
    "number": "#4C9A91",
