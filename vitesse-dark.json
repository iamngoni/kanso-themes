{
  "$schema": "https://raw.githubusercontent.com/iamngoni/kanso-themes/main/schema/kanso-theme-v1.json",
  "schema_version": 1,
  "name": "Vitesse Dark",
  "author": "Anthony Fu",
  "license": "MIT",
  "source": "https://github.com/antfu/vscode-theme-vitesse",
  "description": "Antfu's Vitesse Dark: a quiet charcoal page with muted greens and terracotta.",
  "appearance": "dark",
  "ui": {
    "editor": "#121212",
    "text": "#CECABE",
    "accent": "#4D9375",
    "app": "#121212",
    "sidebar": "#121212",
    "list": "#121212",
    "elevated": "#181818",
    "fill": "#181818",
    "text_secondary": "#858480",
    "text_muted": "#6C6B68",
    "divider": "#252525",
    "link": "#4D9375",
    "row_active": "#222222",
    "row_hover": "#181818",
    "sidebar_active": "#222222",
    "sidebar_hover": "#181818",
    "hover": "#222222",
    "selected": "#222222",
    "active_line": "#181818",
    "button": "#4D9375",
    "button_text": "#121212",
    "success": "#4D9375",
    "warning": "#D4976C",
    "danger": "#CB7676",
    "selection": "#EEEEEE18",
    "caret": "#DBD7CA"
