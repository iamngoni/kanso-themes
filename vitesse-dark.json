    "heading": "#4D9375",
    "link": "#4D9375",
    "quote": "#5D99A9",
    "task_done": "#858480",
    "border": "#252525",
    "code_background": "#181818",
    "code_text": "#CECABE",
    "inline_code_background": "#181818",
    "inline_code_text": "#4D9375",
    "table_header_background": "#181818",
    "selection": "#EEEEEE18"
