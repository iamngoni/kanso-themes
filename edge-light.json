      "font_style": "italic"
    },
    "link": "#B05CCC",
    "url": "#608E32",
    "code": "#608E32",
    "code_block": "#608E32",
    "emphasis": {
      "color": "#4B505B",
      "font_style": "italic"
    },
    "strong": {
      "color": "#4B505B",
      "font_weight": 700
    },
    "front_matter": "#8790A0",
    "html": {
      "color": "#D05858",
      "font_style": "italic"
    },
    "escape": "#BE7E05",
    "comment": {
      "color": "#8790A0",
      "font_style": "italic"
    },
    "comment_doc": {
      "color": "#8790A0",
      "font_style": "italic"
    },
    "keyword": "#B05CCC",
