{
  "$schema": "https://raw.githubusercontent.com/iamngoni/kanso-themes/main/schema/kanso-theme-v1.json",
  "schema_version": 1,
  "name": "Edge Light",
  "author": "sainnhe",
  "license": "MIT",
  "source": "https://github.com/sainnhe/edge",
  "description": "Sainnhe's Edge by day: crisp white paper with purple keywords and calm blues.",
  "appearance": "light",
  "ui": {
    "editor": "#FAFAFA",
    "text": "#4B505B",
