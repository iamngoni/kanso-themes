    "fill": "#EEF1F4",
    "text_secondary": "#646A76",
    "text_muted": "#828B9C",
    "divider": "#DDE2E7",
    "link": "#436DB4",
    "row_active": "#DDE2E7",
    "row_hover": "#EEF1F4",
    "sidebar_active": "#DDE2E7",
    "sidebar_hover": "#E8EBF0",
    "hover": "#DDE2E7",
    "selected": "#F4E9F8",
    "active_line": "#EEF1F4",
    "button": "#A749C6",
    "button_text": "#FAFAFA",
    "success": "#608E32",
    "warning": "#BD7D05",
    "danger": "#D05858",
    "selection": "#DDE2E7",
    "caret": "#4B505B"
