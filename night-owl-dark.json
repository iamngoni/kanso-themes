      "color": "#82AAFF",
      "font_style": "normal"
    },
    "number": "#F78C6C",
    "boolean": "#FF5874",
    "constant": "#82AAFF",
    "variable": "#D6DEEB",
    "variable_special": "#7FDBCA",
    "property": "#D6DEEB",
    "attribute": {
      "color": "#C5E478",
      "font_style": "italic"
    },
    "tag": "#CAECE6",
    "label": "#82AAFF",
    "operator": "#C792EA",
    "punctuation": {
      "color": "#D6DEEB",
      "font_style": "normal"
    },
    "bracket": {
      "color": "#FFD602",
      "font_style": "normal"
    },
    "embedded": "#D6DEEB"
