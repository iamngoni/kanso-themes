  "syntax": {
    "heading": {
      "color": "#82AAFF",
      "font_weight": 700
    },
    "block_marker": {
      "color": "#82AAFF",
      "font_style": "italic"
    },
    "marker": {
      "color": "#D6DEEB",
      "font_style": "normal"
    },
    "list_marker": "#7FDBCA",
    "link": {
      "color": "#82AAFF",
      "font_style": "normal"
    },
    "url": "#7FDBCA",
    "code": "#ECC48D",
    "code_block": "#ECC48D",
    "emphasis": {
      "color": "#82AAFF",
      "font_style": "italic"
    },
    "strong": {
      "color": "#FFCB8B",
      "font_weight": 700
    },
    "front_matter": {
      "color": "#C792EA",
      "font_style": "italic"
    },
    "escape": "#F78C6C",
    "comment": {
      "color": "#637777",
      "font_style": "italic"
    },
    "comment_doc": {
      "color": "#637777",
      "font_style": "italic"
    },
    "keyword": {
      "color": "#C792EA",
      "font_style": "italic"
    },
    "string": "#ECC48D",
    "string_special": "#5CA7E4",
