{
  "$schema": "https://raw.githubusercontent.com/iamngoni/kanso-themes/main/schema/kanso-theme-v1.json",
  "schema_version": 1,
  "name": "Night Owl Dark",
  "author": "Sarah Drasner",
  "license": "MIT",
  "source": "https://github.com/sdras/night-owl-vscode-theme",
  "description": "Sarah Drasner's Night Owl: a deep blue night for late reading, with soft, high-contrast text.",
  "appearance": "dark",
  "ui": {
    "editor": "#011627",
    "text": "#D6DEEB",
    "accent": "#82AAFF",
    "app": "#011627",
    "sidebar": "#011627",
    "list": "#011627",
    "elevated": "#0B2942",
    "fill": "#102435",
    "text_secondary": "#89A4BB",
    "text_muted": "#5F7E97",
    "divider": "#0B2942",
    "link": "#82AAFF",
    "row_active": "#14344F",
    "row_hover": "#0B2942",
    "sidebar_active": "#14344F",
    "sidebar_hover": "#0B2942",
    "hover": "#0B2942",
    "selected": "#14344F",
    "active_line": "#072435",
    "success": "#9CCC65",
    "warning": "#B39554",
    "danger": "#EF5350",
    "selection": "#4373C250",
    "caret": "#80A4C2"
