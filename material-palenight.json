    "list": "#292D3E",
    "elevated": "#292D3E",
    "fill": "#404663",
    "text_secondary": "#8C92B3",
    "text_muted": "#6F769C",
    "divider": "#292D3E",
    "link": "#BABED8",
    "row_active": "#2D3142",
    "row_hover": "#292D3E",
    "sidebar_active": "#2D3142",
    "sidebar_hover": "#292D3E",
    "hover": "#292D3E",
    "selected": "#292D3E",
    "active_line": "#1C1F2B",
    "warning": "#887455",
    "danger": "#916E7E",
    "selection": "#BABED818"
