  "syntax": {
    "text": "#1F1F1F",
    "heading": {
      "color": "#644AC9",
      "font_weight": 700
    },
    "block_marker": "#644AC9",
    "marker": "#6C664B",
    "list_marker": "#036A96",
    "task": "#036A96",
    "hr": "#6C664B",
    "quote": {
      "color": "#846E15",
      "font_style": "italic"
    },
    "link": "#A3144D",
    "url": "#036A96",
    "code": "#14710A",
    "code_block": "#14710A",
    "emphasis": {
      "color": "#846E15",
      "font_style": "italic"
    },
    "strong": {
      "color": "#A34D14",
      "font_weight": 700
    },
    "front_matter": "#6C664B",
    "html": "#A3144D",
    "escape": "#A3144D",
    "comment": {
      "color": "#6C664B",
      "font_style": "italic"
    },
    "comment_doc": {
      "color": "#6C664B",
      "font_style": "italic"
    },
    "keyword": "#A3144D",
    "string": "#846E15",
    "string_special": "#CB3A2A",
