{
  "$schema": "https://raw.githubusercontent.com/iamngoni/kanso-themes/main/schema/kanso-theme-v1.json",
  "schema_version": 1,
  "name": "Alucard",
  "author": "Zeno Rocha",
  "license": "MIT",
  "source": "https://github.com/dracula/dracula-theme",
  "description": "Dracula's daylight twin: warm parchment with deep pink keywords and purple constants.",
  "appearance": "light",
  "ui": {
    "editor": "#FFFBEB",
    "text": "#1F1F1F",
    "accent": "#644AC9",
    "app": "#DEDCCF",
    "sidebar": "#ECE9DF",
    "list": "#F5F2E5",
    "elevated": "#ECE9DF",
    "fill": "#ECE9DF",
    "text_secondary": "#4A4739",
    "text_muted": "#6C664B",
    "divider": "#DEDCCF",
    "link": "#036A96",
    "row_active": "#CFCFDE",
    "row_hover": "#ECE9DF",
    "sidebar_active": "#CFCFDE",
    "sidebar_hover": "#DEDCCF",
    "hover": "#DCDEEF",
    "selected": "#CFCFDE",
    "active_line": "#ECE9DF",
    "button": "#644AC9",
    "button_text": "#FFFBEB",
    "success": "#14710A",
    "warning": "#A34D14",
    "danger": "#CB3A2A",
    "selection": "#CFCFDE",
    "caret": "#1F1F1F"
