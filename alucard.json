      "color": "#14710A",
      "font_style": "italic"
    },
    "tag": "#A3144D",
    "label": "#036A96",
    "operator": "#A3144D",
    "punctuation": "#1F1F1F",
    "bracket": "#1F1F1F",
    "embedded": "#1F1F1F"
