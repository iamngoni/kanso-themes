    "row_hover": "#F7F7F7",
    "sidebar_active": "#EDEDED",
    "sidebar_hover": "#F7F7F7",
    "hover": "#F0F0F0",
    "selected": "#EDEDED",
    "active_line": "#F7F7F7",
    "button": "#1C6B48",
